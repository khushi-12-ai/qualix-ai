# Qualix AI Configuration Template
# Create a copy named '.env' and populate key variables for production deployments.

# Symmetric key for at-rest file encryption (Generated dynamically if blank)
QUALIX_ENCRYPTION_KEY=

# Secret key for session signature validations
QUALIX_SECRET_KEY=

# ClamAV daemon socket configurations
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Database URI (Defaults to SQLite schema if needed)
DATABASE_URL=
